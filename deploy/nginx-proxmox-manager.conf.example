# nginx reverse proxy for HTTPS. deploy/enable-https.sh writes this for you
# (/etc/nginx/sites-available/proxmox-manager) and also sets PM_HOST=127.0.0.1 and
# PM_SESSION_COOKIE_SECURE=true in /opt/proxmox-manager/.env. To do it by hand: copy this to
# /etc/nginx/sites-available/, adjust server_name and the certificate paths, symlink it into
# sites-enabled, remove sites-enabled/default, nginx -t, reload nginx, then change .env.

server {
    listen 80 default_server;
    server_name _;
    return 301 https://proxmox.example.com$request_uri;
}

server {
    listen 443 ssl http2;
    server_name proxmox.example.com;

    ssl_certificate     /etc/ssl/proxmox-manager/fullchain.pem;
    ssl_certificate_key /etc/ssl/proxmox-manager/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:pmssl:10m;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "same-origin" always;
    client_max_body_size 1m;

    location / {
        proxy_pass         http://127.0.0.1:8080;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;   # SMART reads on a node with many disks can take a while
    }
}
