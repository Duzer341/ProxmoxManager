# Proxmox Manager configuration. Copy to .env and edit.
# install.sh generates a .env with a random PM_SECRET_KEY for you.

# REQUIRED. Signs session cookies and encrypts stored Proxmox credentials.
# Generate: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
# Changing it later logs everyone out and makes stored tokens/passwords unreadable.
PM_SECRET_KEY=

# Listen address / port
PM_HOST=0.0.0.0
PM_PORT=8080

# Where the SQLite database lives (directory is created if missing)
PM_DATA_DIR=/var/lib/proxmox-manager

# Seconds between polls of every host, and per-request timeout to a PVE host
PM_POLL_INTERVAL=60
PM_PVE_TIMEOUT=15
PM_POLL_WORKERS=8

# Rolling-average window shown on the dashboard (minutes) and sample retention (hours)
PM_AVERAGE_WINDOW_MINUTES=60
PM_SAMPLE_RETENTION_HOURS=24

# Set to true once the app is served over HTTPS (reverse proxy)
PM_SESSION_COOKIE_SECURE=false
PM_SESSION_MAX_AGE=43200

# Optional: create the first admin automatically on first start, then REMOVE these lines.
# Alternatively run:  python manage.py create-admin <username>
#PM_INITIAL_ADMIN_USERNAME=admin
#PM_INITIAL_ADMIN_PASSWORD=change-me-now

PM_LOG_LEVEL=INFO
