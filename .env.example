# Proxmox Manager configuration. Copy to .env and edit.
# install.sh generates a .env with a random PM_SECRET_KEY for you.

# REQUIRED. Signs session cookies and encrypts stored Proxmox credentials.
# Generate: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
# Changing it later logs everyone out and makes stored tokens/passwords unreadable.
PM_SECRET_KEY=

# Listen address / port
PM_HOST=0.0.0.0
PM_PORT=8080

# Where the SQLite database lives (directory is created if missing)
PM_DATA_DIR=/var/lib/proxmox-manager

# Seconds between polls of every host, and per-request timeout to a PVE host
PM_POLL_INTERVAL=60
# How often each guest's config is re-read for its full disk list (seconds)
#PM_GUEST_DISK_REFRESH=300
PM_PVE_TIMEOUT=15
PM_POLL_WORKERS=8

# Rolling-average window shown on the dashboard (minutes) and sample retention (hours)
PM_AVERAGE_WINDOW_MINUTES=60
PM_SAMPLE_RETENTION_HOURS=24

# Secure-only session cookie (default true). false only for the first plain-HTTP start;
# deploy/enable-https.sh sets it to true.
PM_SESSION_COOKIE_SECURE=false
PM_SESSION_MAX_AGE=43200

# Optional: create the first admin automatically on first start, then REMOVE these lines.
# Alternatively run:  python manage.py create-admin <username>
#PM_INITIAL_ADMIN_USERNAME=admin
#PM_INITIAL_ADMIN_PASSWORD=change-me-now

PM_LOG_LEVEL=INFO

# Show "Open PVE web UI" links. Set false when browsers can't reach the hosts directly and
# everything goes through the dashboard (consoles always do).
#PM_SHOW_PVE_LINKS=true
# Console relay: how long a session may stay open (seconds), and the idle close (minutes).
#PM_CONSOLE_MAX_SECONDS=7200
#PM_CONSOLE_IDLE_MINUTES=15
# Console log rows (who opened which console, when, from where) are kept this many days.
#PM_CONSOLE_LOG_RETENTION_DAYS=365

# --- Console re-auth ---
# Minutes a console re-auth (fresh authenticator code / Microsoft sign-in) lasts for that browser.
#PM_STEPUP_MINUTES=15
# Entra ID P1: Conditional Access authentication context to require at the console re-auth.
#PM_ENTRA_STEPUP_ACR=c1

# Microsoft (Entra) sign-ins go back through Microsoft after this many minutes, so a removed role takes effect.
#PM_ENTRA_RECHECK_MINUTES=60
